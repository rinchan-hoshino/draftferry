{
  "name": "folio-userscript",
  "version": "2.0.0",
  "description": "Folio：把 Markdown、本地图片与 Mermaid 图一键导入八大内容平台编辑页的油猴脚本",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "node test/browser.e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "preact": "^11.2.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.1.1"
  }
