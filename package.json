{
  "name": "draftferry-userscript",
  "version": "1.0.0",
  "description": "把 Markdown、本地图片与 Mermaid 图一键导入八大内容平台编辑页的油猴脚本",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.e2e.js",
    "build": "node scripts/build.js",
    "lint": "eslint src scripts test/*.js",
    "check": "npm run lint && npm test && npm run build"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright-core": "1.63.0"
  }
}
