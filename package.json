{
  "name": "draftferry-userscript",
  "version": "0.2.0",
  "description": "稿渡：识别八个内容平台，并在具备可验证编辑器边界的平台安全填入 Markdown",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.js",
    "check": "npm run lint && npm test && npm run build && npm run verify:dist && npm run verify:ui",
    "lint": "eslint src scripts test/*.js",
    "verify:dist": "node scripts/verify-dist.js",
    "verify:ui": "node scripts/verify-ui.js"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0"
  }
}
